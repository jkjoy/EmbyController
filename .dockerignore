# 版本控制 / CI
.git
.github

# 依赖与构建产物（镜像内会重新安装 / 生成）
vendor
node_modules

# 运行时与本地敏感文件（.env 仅用于本地开发/旧配置迁移；Docker 数据库配置由 Compose 注入）
runtime/*
app/runtime/log
.env
# SQLite 数据文件和 WAL/SHM 仅保存在部署目录，不进入镜像。
data
backups
# Compose 中直接填写数据库连接，部署文件无需进入应用镜像。
docker-compose*.yml
docker-compose*.yaml
compose.yml
compose.yaml

# 文档、演示数据、编辑器配置
docs
docker/*.sql
docker/nginx.conf
*.md
.idea
.vscode
.DS_Store
Thumbs.db
